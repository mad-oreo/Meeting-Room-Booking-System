rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Admin collection: each document has admin's UID as the doc ID.
    match /adminInfo/{adminId} {
      allow read, create, update, delete: if request.auth != null;
    }

    // User collection: each document has user's UID as the doc ID.
    match /userInfo/{userId} {
      allow create, read: if request.auth != null;
      allow update, delete: if request.auth != null
        && request.auth.uid == userID;
    }

    // Bookings: all signed-in users can read/write booking details.
    // Adjust to your needs—this allows any authenticated user to modify.
    match /bookingDetails/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}